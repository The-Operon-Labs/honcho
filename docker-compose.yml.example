networks:
  default:
    name: operon_network
    external: true

volumes:
  # pgdata:
  # redis-data:
  huggingface_cache:
    name: operon-dev_huggingface_cache
    external: true
  # -- Development: uncomment if using source mounts --
  # venv:
  # prometheus-data:
